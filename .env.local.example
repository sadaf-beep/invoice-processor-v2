ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Gmail scan (optional) — see README "Connecting Gmail" section
GMAIL_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=obtained-once-via-/api/gmail/auth

# Daily automation (optional) — see README "Daily automation" section
# POSTGRES_URL and friends are injected automatically once you connect a
# Vercel Postgres database — do not set them by hand.
CRON_SECRET=any-random-string-e.g.-openssl-rand-hex-32
